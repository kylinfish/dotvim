--color
--ignore-case
--sort-files

--ignore-dir=vendor/
--ignore-dir=node_modules/
--ignore-dir=.git
--ignore-dir=.svn
--ignore-dir=venv/
--ignore-dir=.venv/
--ignore-dir=src/venv/

--type-add=php:ext:phtml,phps

# define new types
--type-set=markdown:ext:md,markdown
--type-set=json:ext:json
--type-set=blade:match:.blade.php$
